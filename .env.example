# OpenAI-compatible model endpoint used by UI-TARS SDK.
# For Volcengine Ark, the usual base URL is:
# https://ark.cn-beijing.volces.com/api/v3
CUA_LARK_MODEL_BASE_URL=

# Use an Ark endpoint ID or model ID here, for example ep-xxxxxxxx.
CUA_LARK_MODEL=

# Never commit a real API key.
CUA_LARK_MODEL_API_KEY=

# Optional defaults for the first IM smoke case.
CUA_LARK_FEISHU_GROUP_NAME=CUA-Lark测试群
CUA_LARK_MESSAGE_PREFIX=CUA-Lark test

